# ─── Copia este archivo a .env y rellénalo. Nunca subas .env al repositorio. ───

# Marca y URLs
BRAND_NAME=Trazado
PUBLIC_BASE_URL=https://tu-dominio.com
CONTACT_EMAIL=hola@tu-dominio.com

# Secretos (genera cada uno con: openssl rand -base64 32)
APP_SECRET=
INTERNAL_API_SECRET=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=

# Base de datos (docker compose la construye con POSTGRES_PASSWORD)
DATABASE_URL=postgres://poster:${POSTGRES_PASSWORD}@postgres:5432/poster

# Stripe (https://dashboard.stripe.com/test/apikeys). Empieza con claves sk_test_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gelato (https://dashboard.gelato.com → Developer → API keys)
GELATO_API_KEY=
# draft = los pedidos quedan en borrador en Gelato (no se imprimen). Cambia a "order" para producir de verdad.
GELATO_ORDER_TYPE=draft
GELATO_WEBHOOK_SECRET=

# Emails (https://resend.com). Sin clave, los emails sólo se registran en /admin/emails
RESEND_API_KEY=
EMAIL_FROM=Trazado <pedidos@tu-dominio.com>

# Almacenamiento de archivos: local (volumen docker) o s3 (Cloudflare R2)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=posters
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Envíos (céntimos, IVA incluido)
SHIPPING_ES_CENTS=490
SHIPPING_EU_CENTS=990
DOWNLOAD_DAYS=30

# Datos de mapas (worker)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=Trazado poster shop (hola@tu-dominio.com)
# GEOCODER_URL=https://photon.komoot.io/api/
